# Login (Neon Auth) e banco (Neon) — somente servidor. Sem elas o site público
# funciona e as áreas autenticadas mostram "backend não configurado".
# NEON_AUTH_COOKIE_SECRET: aleatório, 32+ caracteres (ex.: openssl rand -hex 32),
# diferente em cada ambiente. DATABASE_URL: endereço com pool de conexões.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
DATABASE_URL=
# Data API do Neon (leituras do painel com o JWT do usuário) e Vercel Blob privado (fotos).
NEON_DATA_API_URL=
BLOB_READ_WRITE_TOKEN=

# Segundo fator dos administradores (TOTP). 32 bytes aleatórios em base64url
# (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"),
# diferente em cada ambiente e guardado só no servidor. Sem ela, /admin fica fechado.
# Trocar a chave invalida os segundos fatores já configurados (cada admin configura de novo).
ADMIN_MFA_KEY=

# Supabase — dados do painel até a Etapa 3 da migração. Sem estas variáveis o
# site público funciona e as áreas autenticadas mostram "backend não configurado".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Avaliação técnica por IA (somente servidor — nunca use prefixo NEXT_PUBLIC_).
# Nada é enviado ao Gemini enquanto AI_ANALYSIS_ENABLED != "true" E
# ai_settings.enabled = false no banco (padrão). Use sempre o plano PAGO do
# Gemini: no gratuito, os dados podem ser usados para melhorar produtos Google.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
AI_ANALYSIS_ENABLED=false
# Segredo do agendador que chama POST /api/ai/ciclo (Authorization: Bearer ...)
CRON_SECRET=

# Homologação (nunca em produção). Os scripts de homologação recusam rodar se
# VP_ENV não for "homolog" ou se a URL do Supabase não for a do projeto abaixo.
VP_ENV=
HOMOLOG_SUPABASE_REF=
