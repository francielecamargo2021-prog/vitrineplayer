# Todas as variáveis são SOMENTE DO SERVIDOR (nunca use o prefixo NEXT_PUBLIC_).
# Cada ambiente (local, homologação, produção) tem os SEUS valores.
#
# Ambiente: "homolog" ou "production" na Vercel. Com um desses valores, o build
# RECUSA publicar se faltar alguma variável abaixo (nada de "backend não configurado").
# Só VP_ENV=production deixa o site ser indexado por buscadores.
VP_ENV=

# Banco (Neon) — endereço com pool de conexões.
DATABASE_URL=

# Login (Neon Auth). NEON_AUTH_COOKIE_SECRET: aleatório, 32+ caracteres
# (ex.: openssl rand -hex 32). Também assina o "aparelho reconhecido" e as chaves do
# limite de tentativas: trocá-lo encerra sessões e zera esses contadores.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Data API do Neon (leituras do painel com o JWT do usuário).
NEON_DATA_API_URL=

# Vercel Blob privado (fotos). Um store por ambiente.
BLOB_READ_WRITE_TOKEN=

# Segundo fator dos administradores (TOTP). 32 bytes aleatórios em base64url
# (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
# Sem ela, /admin fica fechado. Trocar a chave invalida os segundos fatores já
# configurados (cada admin configura de novo).
ADMIN_MFA_KEY=

# Avaliação técnica por IA — DESLIGADA. Nada é enviado ao Gemini enquanto
# AI_ANALYSIS_ENABLED != "true" E ai_settings.enabled = false no banco (padrão).
# Não defina GEMINI_API_KEY nem CRON_SECRET sem autorização. Se um dia for ligada,
# use sempre o plano PAGO do Gemini (no gratuito, os dados podem ser usados pelo Google).
AI_ANALYSIS_ENABLED=false
GEMINI_API_KEY=
# Segredo do agendador que chama POST /api/ai/ciclo (Authorization: Bearer ...)
CRON_SECRET=
